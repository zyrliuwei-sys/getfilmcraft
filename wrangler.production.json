{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "getfilmcraft",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://getfilmcraft.org",
    "VITE_APP_NAME": "Filmcraft",
    "VITE_APP_DESCRIPTION": "Find FilmCraft download links, English setup guides, browser editing options and beginner tutorials. Compare FilmCraft with Adobe Premiere Pro before you start.",
    "VITE_APP_LOGO": "/logo.svg",
    "VITE_DEFAULT_LOCALE": "en"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "getfilmcraft",
      "database_id": "da47f6be-4baf-4881-9551-0dba81fa5eb0",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [
    {
      "pattern": "getfilmcraft.org",
      "custom_domain": true
    }
  ]
}
